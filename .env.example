# =============================================================================
# Quant Platform environment template — copy to `.env` and fill in values.
# NEVER commit a real `.env`. NEVER print these values in logs.
# =============================================================================

# ---- Kimi runtime model gateway (application LLM provider) ----
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL=kimi-k2.6

# ---- Bloomberg Desktop API (BLPAPI) ----
# Leave empty to force CSV/XLSX export fallback mode.
BLOOMBERG_HOST=localhost
BLOOMBERG_PORT=8194

# ---- IBKR TWS / IB Gateway (PAPER ACCOUNT ONLY) ----
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=17
IBKR_ACCOUNT=

# ---- Trading safety gate (defaults are mandatory-safe) ----
# "paper" is the ONLY supported mode. Any other value is rejected at startup.
TRADING_MODE=paper
# "true" = compute orders but submit NOTHING. Must be explicitly disabled.
DRY_RUN=true

# ---- Optional model cost guards ----
# Max estimated USD spend per research run / per UTC day. 0 = disabled.
MODEL_BUDGET_USD_PER_RUN=0
MODEL_BUDGET_USD_PER_DAY=0

# ---- Data root (override only for tests) ----
QUANT_DATA_ROOT=data
