# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
build/

# Secrets — NEVER commit
.env
.env.*
!.env.example
*.pem
*.key

# Data artifacts — raw/proprietary data must not be committed
data/*
